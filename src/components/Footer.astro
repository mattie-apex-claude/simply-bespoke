---
const year = new Date().getFullYear();

const services = [
  { href: '/services/bathroom-sealant',          label: 'Bathroom Sealant' },
  { href: '/services/kitchen-sealant',           label: 'Kitchen Sealant' },
  { href: '/services/window-door-sealing',       label: 'Window & Door Sealing' },
  { href: '/services/internal-sealant',          label: 'Internal Sealant' },
  { href: '/services/external-sealant',          label: 'External Sealant' },
  { href: '/services/new-build-sealants',        label: 'New Build Sealants' },
  { href: '/services/expansion-movement-joints', label: 'Expansion Joints' },
];

const areas = [
  { href: '/newcastle',     label: 'Newcastle' },
  { href: '/sunderland',    label: 'Sunderland' },
  { href: '/durham',        label: 'Durham' },
  { href: '/gateshead',     label: 'Gateshead' },
  { href: '/middlesbrough', label: 'Middlesbrough' },
  { href: '/darlington',    label: 'Darlington' },
];

const company = [
  { href: '/domestic',   label: 'Domestic' },
  { href: '/commercial', label: 'Commercial' },
  { href: '/projects',   label: 'Projects' },
  { href: '/about',      label: 'About' },
  { href: '/reviews',    label: 'Reviews' },
  { href: '/contact',    label: 'Contact' },
];
---

<footer class="site-footer">
  <div class="site-footer__main">
    <div class="container">
      <div class="site-footer__grid">

        <div class="site-footer__brand">
          <a href="/" aria-label="Simply Bespoke Ltd — Home">
            <img src="/images/logo/Logo.jpg" alt="Simply Bespoke Ltd" class="site-footer__logo" />
          </a>
          <p class="site-footer__tagline">
            Professional mastic, silicone and sealant specialists serving domestic and commercial clients across the North East of England.
          </p>

          <!-- Contact links -->
          <div class="site-footer__contact">
            <a href="tel:07553579237" class="site-footer__contact-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
              07553 579237
            </a>
            <a href="mailto:info@simplybespoke.co.uk" class="site-footer__contact-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
              info@simplybespoke.co.uk
            </a>
            <a href="https://wa.me/447553579237" class="site-footer__contact-link site-footer__contact-link--wa" target="_blank" rel="noopener noreferrer">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp Us
            </a>
          </div>

          <!-- Social links -->
          <div class="social-links">
            <a href="https://www.facebook.com/simplybespokeltd/" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Simply Bespoke on Facebook">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="https://www.instagram.com/simply_bespoke_sealants/" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Simply Bespoke on Instagram">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
          </div>
        </div>

        <div class="site-footer__col">
          <h4 class="site-footer__heading">Services</h4>
          <ul class="site-footer__list">
            {services.map(s => <li><a href={s.href} class="site-footer__link">{s.label}</a></li>)}
            <li><a href="/services" class="site-footer__link site-footer__link--more">All Services →</a></li>
          </ul>
        </div>

        <div class="site-footer__col">
          <h4 class="site-footer__heading">Areas We Cover</h4>
          <ul class="site-footer__list">
            {areas.map(a => <li><a href={a.href} class="site-footer__link">{a.label}</a></li>)}
            <li><a href="/areas-we-cover" class="site-footer__link site-footer__link--more">All Areas →</a></li>
          </ul>
        </div>

        <div class="site-footer__col">
          <h4 class="site-footer__heading">Company</h4>
          <ul class="site-footer__list">
            {company.map(c => <li><a href={c.href} class="site-footer__link">{c.label}</a></li>)}
          </ul>
        </div>

      </div>
    </div>
  </div>

  <div class="site-footer__bottom">
    <div class="container site-footer__bottom-inner">
      <p>&copy; {year} Simply Bespoke Ltd. All rights reserved.</p>
      <p>
        Website by <a href="https://apexflow.co.uk" class="site-footer__credit" target="_blank" rel="noopener noreferrer">Apexflow</a>
        &nbsp;&middot;&nbsp;
        Mastic &amp; Sealant Specialists — North East England
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--color-navy); color: rgba(255,255,255,.8); }

  .site-footer__main { padding-block: clamp(3rem, 6vw, 5rem); }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
  }

  .site-footer__logo {
    height: 42px; width: auto;
    margin-bottom: 1.25rem;
  }

  .site-footer__tagline {
    font-size: .875rem; line-height: 1.7;
    color: rgba(255,255,255,.6);
    max-width: 34ch; margin-bottom: 1.25rem;
  }

  /* Contact links */
  .site-footer__contact {
    display: flex; flex-direction: column; gap: .5rem;
    margin-bottom: .75rem;
  }
  .site-footer__contact-link {
    display: flex; align-items: center; gap: .5rem;
    font-size: .8rem; font-weight: 500;
    color: rgba(255,255,255,.7);
    transition: color var(--dur-fast) ease;
  }
  .site-footer__contact-link:hover { color: #fff; }
  .site-footer__contact-link--wa { color: #5dda85; }
  .site-footer__contact-link--wa:hover { color: #7de89d; }

  .site-footer__heading {
    font-family: var(--font-body);
    font-size: .7rem; font-weight: 600;
    letter-spacing: .1em; text-transform: uppercase;
    color: rgba(255,255,255,.45);
    margin-bottom: 1rem;
  }

  .site-footer__list { list-style: none; display: flex; flex-direction: column; gap: .4rem; }

  .site-footer__link {
    font-size: .875rem;
    color: rgba(255,255,255,.7);
    transition: color var(--dur-fast) var(--ease-std);
    display: block; padding-block: .1rem;
  }
  .site-footer__link:hover { color: #fff; }
  .site-footer__link--more { color: var(--color-blue); margin-top: .25rem; font-weight: 500; }
  .site-footer__link--more:hover { color: #6ba3ff; }

  .site-footer__bottom {
    border-top: 1px solid rgba(255,255,255,.1);
    padding-block: 1.25rem;
  }
  .site-footer__bottom-inner {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: .75rem;
  }
  .site-footer__bottom-inner p {
    font-size: .78rem; color: rgba(255,255,255,.4);
    max-width: none; margin: 0;
  }
  .site-footer__credit {
    color: rgba(255,255,255,.55);
    transition: color var(--dur-fast) ease;
  }
  .site-footer__credit:hover { color: #fff; }

  @media (max-width: 1023px) {
    .site-footer__grid { grid-template-columns: 1fr 1fr; gap: 2.5rem; }
    .site-footer__brand { grid-column: span 2; }
  }
  @media (max-width: 599px) {
    .site-footer__grid { grid-template-columns: 1fr; }
    .site-footer__brand { grid-column: span 1; }
    .site-footer__bottom-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
