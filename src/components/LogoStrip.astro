---
import { clientLogos } from '../data/images';

interface Props {
  title?: string;
}

const { title = 'Trusted by Leading Organisations Across the North East' } = Astro.props;
---

<section class="logo-strip" aria-label="Commercial clients">
  <div class="container">
    <div class="logo-strip__header">
      <span class="eyebrow">Commercial Clients</span>
      <h2>{title}</h2>
    </div>
    <div class="logo-strip__grid">
      {clientLogos.map(logo => (
        <img
          src={logo.src}
          alt={logo.alt}
          class="logo-strip__logo"
          loading="lazy"
        />
      ))}
    </div>
  </div>
</section>
