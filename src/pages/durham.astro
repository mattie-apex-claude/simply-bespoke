---
import Layout from '../layouts/Layout.astro';
import CTABanner from '../components/CTABanner.astro';
import * as imgs from '../data/images';
---

<Layout
  title="Mastic & Sealant Specialists Durham | Simply Bespoke"
  description="Professional mastic and sealant services across Durham city and county. Domestic bathroom and kitchen sealing, new build sealants and commercial sealant work. Free quotes."
>
  <section class="page-hero">
    <div class="container page-hero__content">
      <span class="eyebrow eyebrow--white">Durham</span>
      <h1>Mastic &amp; Sealant Specialists in Durham</h1>
      <p>Professional mastic and sealant services across Durham city and the wider County Durham area — for homeowners and commercial clients alike.</p>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <span class="eyebrow">Durham Coverage</span>
      <h2>Simply Bespoke in Durham</h2>
      <div class="prose">
        <p>Mastic and sealant services across Durham city and County Durham — domestic and commercial. Period properties, new builds and everything in between, to the same high standard throughout.</p>
        <h3>Domestic Sealant in Durham</h3>
        <p>For Durham homeowners, we provide professional domestic sealant services including bathroom and shower silicone resealing, kitchen worktop and splashback mastic, window and door sealing and external brickwork and joint sealant. We understand that many Durham properties have their own character and take care to deliver work that suits the property.</p>
        <h3>New Build &amp; Commercial in County Durham</h3>
        <p>County Durham continues to see significant new residential development. Simply Bespoke works with housebuilders and main contractors on new build sealant packages across County Durham, delivering internal and external sealant application to specification and on schedule.</p>
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="durham-services">
    <div class="container">
      <h2 id="durham-services">Sealant Services Available in Durham</h2>
      <div class="location-services">
        <div class="location-service-item">Bathroom Sealant &amp; Resealing</div>
        <div class="location-service-item">Kitchen Mastic &amp; Worktop Sealing</div>
        <div class="location-service-item">Window &amp; Door Frame Sealing</div>
        <div class="location-service-item">Floor &amp; Skirting Sealant</div>
        <div class="location-service-item">External Brickwork &amp; Joint Sealing</div>
        <div class="location-service-item">New Build Sealant Packages</div>
        <div class="location-service-item">Commercial Sealant Application</div>
        <div class="location-service-item">Expansion &amp; Movement Joint Sealing</div>
      </div>
      <div class="btn-group mt-2">
        <a href="/contact" class="btn btn--primary">Request a Free Quote</a>
        <a href="/services" class="btn btn--outline">View All Services</a>
      </div>
    </div>
  </section>

  <CTABanner
    title="Free Quote for Durham Sealant Work"
    description="Get a free, no-obligation quote for domestic or commercial mastic and sealant work across Durham and County Durham."
    buttonText="Request a Free Quote"
  />
</Layout>
