---
import Layout from '../layouts/Layout.astro';
import CTABanner from '../components/CTABanner.astro';
import * as imgs from '../data/images';
---

<Layout
  title="Mastic & Sealant Specialists Middlesbrough | Simply Bespoke"
  description="Professional mastic and sealant services in Middlesbrough and across Teesside. Commercial and industrial sealant, new build packages and domestic sealing. Free quotes."
>
  <section class="page-hero">
    <div class="container page-hero__content">
      <span class="eyebrow eyebrow--white">Middlesbrough</span>
      <h1>Mastic &amp; Sealant Specialists in Middlesbrough</h1>
      <p>Professional commercial and domestic sealant services across Middlesbrough and the wider Teesside area.</p>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <span class="eyebrow">Middlesbrough &amp; Teesside Coverage</span>
      <h2>Simply Bespoke in Middlesbrough</h2>
      <div class="prose">
        <p>Simply Bespoke provides professional mastic and sealant services across Middlesbrough and the wider Teesside region. Middlesbrough's combination of established commercial activity, industrial facilities and ongoing residential development creates a diverse range of sealant requirements that we are well placed to meet.</p>
        <h3>Commercial &amp; Industrial Sealant in Middlesbrough</h3>
        <p>Commercial and industrial buildings in Middlesbrough present specific sealant challenges — high-traffic environments, industrial-scale expansion joints, chemical resistance requirements and specialist fire-rated applications. Simply Bespoke has experience delivering commercial sealant work across a range of building types and environments in Teesside.</p>
        <h3>New Build &amp; Residential Sealant</h3>
        <p>Middlesbrough and the wider Teesside area continue to see new residential development. Simply Bespoke works with housebuilders and developers on new build sealant packages across the region, delivering complete internal and external sealant programmes to specification.</p>
        <h3>Domestic Sealant in Middlesbrough</h3>
        <p>For homeowners across Middlesbrough, we provide professional domestic sealant services including bathroom resealing, kitchen mastic, window sealing and external brickwork sealant. Free, no-obligation quotes available.</p>
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="middlesbrough-services">
    <div class="container">
      <h2 id="middlesbrough-services">Sealant Services Available in Middlesbrough</h2>
      <div class="location-services">
        <div class="location-service-item">Bathroom &amp; Shower Resealing</div>
        <div class="location-service-item">Kitchen Worktop &amp; Splashback Sealant</div>
        <div class="location-service-item">Window &amp; Door Frame Sealing</div>
        <div class="location-service-item">Industrial &amp; Commercial Sealant</div>
        <div class="location-service-item">New Build Sealant Packages</div>
        <div class="location-service-item">Expansion &amp; Movement Joint Sealing</div>
        <div class="location-service-item">Fire-Rated Sealant Application</div>
        <div class="location-service-item">Air Testing Sealant</div>
      </div>
      <div class="btn-group mt-2">
        <a href="/contact" class="btn btn--primary">Request a Free Quote</a>
        <a href="/services" class="btn btn--outline">View All Services</a>
      </div>
    </div>
  </section>

  <CTABanner
    title="Free Quote for Middlesbrough Sealant Work"
    description="Get a free, no-obligation quote for domestic or commercial mastic and sealant work across Middlesbrough and Teesside."
    buttonText="Request a Free Quote"
  />
</Layout>
