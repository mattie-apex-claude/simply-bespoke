---

<Layout
  title="Sealant Projects Gallery | Simply Bespoke, North East England"
  description="Browse completed mastic and sealant projects by Simply Bespoke across the North East of England. Bathroom, kitchen, window, external and commercial sealant work."
>
  <section class="page-hero">
    <div class="container page-hero__content">
      <span class="eyebrow eyebrow--white">Our Work</span>
      <h1>Completed Projects</h1>
      <p>A showcase of completed mastic and sealant work across the North East — domestic and commercial projects delivered to a consistently high standard.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="projects-h2">
    <div class="container">
      <div class="section__header">
        <span class="eyebrow">Project Gallery</span>
        <h2 id="projects-h2">Simply Bespoke — Completed Work</h2>
        <p class="text-muted">Real project photography from domestic and commercial sealant work across the North East.</p>
      </div>

      <!-- Feature grid -->
      <div class="projects-feature-grid">
        {allProjects.slice(0, 6).map((p, i) => (
          <div class={`projects-feature-grid__item${i === 0 ? ' projects-feature-grid__item--large' : ''}`}>
            <img src={p.src} alt={p.alt} loading={i < 3 ? 'eager' : 'lazy'} />
            <div class="projects-feature-grid__label" aria-hidden="true">{p.category}</div>
          </div>
        ))}
      </div>

      <!-- Standard grid -->
      <div class="projects-standard-grid" style="margin-top:4px">
        {allProjects.slice(6).map(p => (
          <div class="projects-standard-grid__item">
            <img src={p.src} alt={p.alt} loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    title="Ready to Start Your Project?"
    description="Get a free, no-obligation quote for domestic or commercial mastic and sealant work across the North East."
  />
</Layout>

<style>
  .projects-feature-grid {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    grid-auto-rows: 320px;
    gap: 4px;
  }
  .projects-feature-grid__item {
    overflow: hidden; position: relative; background: var(--color-border);
  }
  .projects-feature-grid__item--large {
    grid-column: span 2; grid-row: span 2;
  }
  .projects-feature-grid__item img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform .4s ease;
  }
  .projects-feature-grid__item:hover img { transform: scale(1.03); }

  .projects-feature-grid__label {
    position: absolute; bottom: 0; left: 0; right: 0;
    padding: .75rem 1rem;
    background: linear-gradient(transparent, rgba(27,42,74,.7));
    color: #fff; font-size: .75rem; font-weight: 600;
    letter-spacing: .08em; text-transform: uppercase;
    opacity: 0; transition: opacity var(--transition);
  }
  .projects-feature-grid__item:hover .projects-feature-grid__label { opacity: 1; }

  .projects-standard-grid {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 4px;
  }
  .projects-standard-grid__item { overflow: hidden; aspect-ratio: 1; background: var(--color-border); }
  .projects-standard-grid__item img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform .4s ease;
  }
  .projects-standard-grid__item:hover img { transform: scale(1.04); }

  @media (max-width: 767px) {
    .projects-feature-grid {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 200px;
    }
    .projects-feature-grid__item--large { grid-column: span 2; grid-row: span 1; }
    .projects-standard-grid { grid-template-columns: repeat(2,1fr); }
  }
</style>
