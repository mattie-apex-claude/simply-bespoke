---
import Layout from '../layouts/Layout.astro';
import QuoteForm from '../components/QuoteForm.astro';
---

<Layout
  title="Contact Simply Bespoke | Request a Free Sealant Quote — North East England"
  description="Get a free, no-obligation quote for domestic or commercial mastic and sealant work across the North East. Call 07553 579237, email info@simplybespoke.co.uk or use our quick quote form."
>
  <section class="page-hero">
    <div class="container page-hero__content">
      <span class="eyebrow eyebrow--white">Get in Touch</span>
      <h1>Request a Free Quote</h1>
      <p>Domestic and commercial sealant quotes across the North East. Fill in the form or contact us directly.</p>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <QuoteForm />
    </div>
  </section>

</Layout>
