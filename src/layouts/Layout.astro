---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Simply Bespoke Ltd | Mastic & Sealant Specialists — North East England',
  description = 'Professional mastic, silicone and sealant specialists serving domestic and commercial clients across the North East of England. Expert sealant application for bathrooms, kitchens, windows, doors and commercial projects. Free quotes.',
  ogImage = '/images/logo/Logo.jpg',
} = Astro.props;

const siteUrl  = 'https://www.simplybespoke.co.uk';
const canonical = new URL(Astro.url.pathname, siteUrl).href;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Simply Bespoke Ltd',
  description: 'Professional mastic, silicone and sealant specialists serving the North East of England.',
  url: siteUrl,
  telephone: '+447553579237',
  email: 'info@simplybespoke.co.uk',
  areaServed: { '@type': 'AdministrativeArea', name: 'North East England' },
  priceRange: '££',
  sameAs: [
    'https://www.facebook.com/simplybespokeltd/',
    'https://www.instagram.com/simply_bespoke_sealants/',
  ],
  serviceType: ['Mastic Sealing', 'Silicone Application', 'Sealant Services', 'Commercial Sealant', 'New Build Sealants'],
});
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url"         content={canonical} />
    <meta property="og:site_name"   content="Simply Bespoke Ltd" />
    <meta property="og:image"       content={`${siteUrl}${ogImage}`} />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={`${siteUrl}${ogImage}`} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={jsonLd} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- WhatsApp float -->
    <a
      href="https://wa.me/447553579237"
      class="whatsapp-float"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat with Simply Bespoke on WhatsApp"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      <span class="whatsapp-float__label">WhatsApp</span>
    </a>
  </body>
</html>

<script>
// ── Scroll entrance: Intersection Observer ─────────────────────────────────────
(function () {
  if (!('IntersectionObserver' in window)) return;

  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.06, rootMargin: '0px 0px -44px 0px' }
  );

  function rev(el: Element) {
    el.classList.add('reveal');
    io.observe(el);
  }

  function revStagger(selector: string) {
    document.querySelectorAll(selector).forEach((grid) => {
      Array.from(grid.children).forEach((child, i) => {
        (child as HTMLElement).style.setProperty('--stagger', String(i));
        rev(child);
      });
    });
  }

  // Block-level elements
  document.querySelectorAll([
    '.section__header',
    '.why-us__layout',
    '.areas-layout',
    '.logo-strip__grid',
    '.contact-grid',
    '.about-intro',
    '.commercial-intro',
    '.service-intro',
    '.floors-layout',
    '.fire-layout',
    '.air-layout',
  ].join(', ')).forEach(rev);

  // Staggered grid children
  [
    '.services-grid',
    '.about-values',
    '.location-cards',
    '.service-cards',
    '.why-us__points',
    '.commercial-services',
    '.reviews-grid',
    '.location-services',
  ].forEach(revStagger);

  // Project grids — fade only (no Y shift on fixed-size image cells)
  document.querySelectorAll(
    '.projects-feature-grid__item, .projects-standard-grid__item'
  ).forEach((item, i) => {
    (item as HTMLElement).style.setProperty('--stagger', String(i % 9));
    item.classList.add('reveal', 'reveal--fade');
    io.observe(item);
  });

  // Why us points
  document.querySelectorAll('.why-us__point').forEach((el, i) => {
    (el as HTMLElement).style.setProperty('--stagger', String(i));
    rev(el);
  });
})();
</script>

